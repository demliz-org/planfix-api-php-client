{
    "name": "demliz/planfix-api-client",
    "description": "PHP client for the Planfix REST API, generated with OpenAPI Generator",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://github.com/demliz-org/planfix-api-php-client",
    "license": "proprietary",
    "authors": [
        {
            "name": "OpenAPI",
            "homepage": "https://openapi-generator.tech"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3 || ^8.0",
        "guzzlehttp/psr7": "^1.7 || ^2.0 || ^3.0",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "Planfix\\" : "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Planfix\\Test\\" : "test/" }
    }
}
